+FILE *fopen_utf8_source(const char *path)
+{
+#if defined(_WIN32)
+    return fopen_utf8(path, "rb");
+#else
+    int fd = open(path, O_RDONLY | O_NONBLOCK);
+    if (fd == -1)
+        return nullptr;
+    int flags = fcntl(fd, F_GETFL);
+    if (flags != -1)
+        fcntl(fd, F_SETFL, flags & ~O_NONBLOCK);
+    FILE *stream = fdopen(fd, "rb");
+    if (!stream)
+        close(fd);
+    return stream;
+#endif
+}
