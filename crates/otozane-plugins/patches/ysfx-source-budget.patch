+bool get_stream_file_info(FILE *stream, file_info &info)
+{
+#if defined(_WIN32)
+    int fd = _fileno(stream);
+    if (fd == -1)
+        return false;
+    HANDLE handle = (HANDLE)_get_osfhandle(fd);
+    if (handle == INVALID_HANDLE_VALUE)
+        return false;
+    BY_HANDLE_FILE_INFORMATION file;
+    if (!GetFileInformationByHandle(handle, &file))
+        return false;
+    info.size = ((uint64_t)file.nFileSizeHigh << 32) | file.nFileSizeLow;
+    info.regular = GetFileType(handle) == FILE_TYPE_DISK &&
+        (file.dwFileAttributes & (FILE_ATTRIBUTE_DIRECTORY | FILE_ATTRIBUTE_DEVICE)) == 0;
+    return true;
+#else
+    int fd = fileno(stream);
+    if (fd == -1)
+        return false;
+    struct stat st;
+    if (fstat(fd, &st) != 0)
+        return false;
+    info.size = (uint64_t)st.st_size;
+    info.regular = S_ISREG(st.st_mode);
+    return true;
+#endif
+}
