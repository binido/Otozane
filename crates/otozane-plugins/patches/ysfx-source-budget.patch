+namespace {
+
+// Source-size bounds for one load. The parser keeps the text it reads, so the
+// per-file cap and the entry-plus-imports total are memory bounds.
+constexpr uint64_t max_source_file_size = 1u << 20;
+constexpr uint64_t max_source_total_size = 8u << 20;
+
+// Counts bytes as they are read and stops a file at its remaining budget.
+class limited_text_reader : public ysfx::text_reader {
+public:
+    limited_text_reader(ysfx::text_reader &inner, uint64_t limit, uint64_t &total)
+        : m_inner(inner), m_limit(limit), m_total(total) {}
+
+    char read_next_char() override
+    {
+        if (m_exceeded)
+            return '\0';
+        if (m_read >= m_limit) {
+            // One extra byte tells "exactly at the limit" apart from "over it"
+            // without counting or retaining that byte.
+            if (m_inner.read_next_char() == '\0')
+                return '\0';
+            m_exceeded = true;
+            return '\0';
+        }
+        char next = m_inner.read_next_char();
+        if (next == '\0')
+            return '\0';
+        ++m_read;
+        ++m_total;
+        return next;
+    }
+
+    char peek_next_char() override
+    {
+        if (m_exceeded || m_read >= m_limit)
+            return '\0';
+        return m_inner.peek_next_char();
+    }
+
+    bool exceeded() const { return m_exceeded; }
+
+private:
+    ysfx::text_reader &m_inner;
+    uint64_t m_limit;
+    uint64_t &m_total;
+    uint64_t m_read = 0;
+    bool m_exceeded = false;
+};
+
+// Opens a source without blocking and checks the opened descriptor, so a FIFO
+// cannot block and a path swap cannot change the type after the check.
+bool open_source(const char *path, ysfx_t *fx, ysfx::FILE_u &stream, ysfx::file_info &info)
+{
+    stream.reset(ysfx::fopen_utf8_source(path));
+    if (!stream) {
+        ysfx_logf(*fx->config, ysfx_log_error, "%s: cannot open file for reading", ysfx::path_file_name(path).c_str());
+        return false;
+    }
+    if (!ysfx::get_stream_file_info(stream.get(), info)) {
+        ysfx_logf(*fx->config, ysfx_log_error, "%s: cannot inspect source file", ysfx::path_file_name(path).c_str());
+        return false;
+    }
+    if (!info.regular) {
+        ysfx_logf(*fx->config, ysfx_log_error, "%s: source is not a regular file", ysfx::path_file_name(path).c_str());
+        return false;
+    }
+    return true;
+}
+
+// Rejects a source that cannot fit the per-file cap or the remaining budget.
+bool check_source_size(const char *path, ysfx_t *fx, const ysfx::file_info &info, uint64_t total_read, uint64_t &limit)
+{
+    if (info.size >= max_source_file_size) {
+        ysfx_logf(*fx->config, ysfx_log_error, "%s: source file is too large", ysfx::path_file_name(path).c_str());
+        return false;
+    }
+    if (total_read >= max_source_total_size || info.size > max_source_total_size - total_read) {
+        ysfx_logf(*fx->config, ysfx_log_error, "%s: source files exceed the load budget", ysfx::path_file_name(path).c_str());
+        return false;
+    }
+    limit = std::min(max_source_file_size, max_source_total_size - total_read);
+    return true;
+}
