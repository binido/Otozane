# Maintainer: binido <binido@users.noreply.github.com>
# Generated by the release workflow from packaging/linux/PKGBUILD.in.
pkgname=otozane-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc='Real-time microphone processor for PipeWire'
arch=('x86_64' 'aarch64')
url='https://github.com/binido/Otozane'
license=('MIT')
provides=("otozane=$pkgver")
conflicts=('otozane')
depends=('glibc' 'gcc-libs' 'pipewire' 'libglvnd' 'libxkbcommon' 'hicolor-icon-theme')
optdepends=(
  'wireplumber: PipeWire session manager'
  'wayland: native Wayland sessions (otherwise uses X11)'
  'xdg-desktop-portal: file dialogs for profile import and export'
)
options=('!strip' '!debug')
source_x86_64=("$url/releases/download/v$pkgver/otozane-v$pkgver-linux-x86_64.tar.gz")
source_aarch64=("$url/releases/download/v$pkgver/otozane-v$pkgver-linux-aarch64.tar.gz")
sha256sums_x86_64=('@X86_64_SHA256@')
sha256sums_aarch64=('@AARCH64_SHA256@')

package() {
  cp -a "$srcdir/otozane-v$pkgver-linux-$CARCH/usr" "$pkgdir/"
}
